{
  "name": "vue-axios-client",
  "version": "2.2.0",
  "description": "Reusable Axios HTTP client for Vue applications",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && cp src/style.css dist/style.css",
    "prepare": "npm run build",
    "test": "vitest run --environment jsdom"
  },
  "peerDependencies": {
    "axios": "^1.0.0",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "axios": "^1.21.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.12",
    "vue": "^3.5.45"
  }
}
