{
  "name": "vue-axios-client",
  "version": "1.0.1",
  "description": "Reusable Axios HTTP client for Vue applications",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && cp src/style.css dist/style.css && cp src/LoadingOverlay.vue dist/LoadingOverlay.vue",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "axios": "^1.0.0",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "mosha-vue-toastify": "^1.0.23"
  }
}
